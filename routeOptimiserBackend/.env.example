# Backend environment variables.
# Copy to .env (never commit .env) or set these in your hosting provider's dashboard.

# --- Database ---
# Unset  -> SQLite file at data/processed/ner_platform.db (fine for local dev and demos)
# Set    -> PostgreSQL, e.g. a Neon connection string.
#
# This is the shared record. The web console and the mobile field app both write incident
# reports here through this backend, so every instance of the backend must use the SAME value
# — otherwise reports filed on a phone land in a database the console never reads. On a host
# with an ephemeral filesystem (Render's free tier included), leaving this unset also means
# the SQLite file, and every report in it, is discarded on the next restart.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- CORS ---
# Comma-separated list of allowed frontend origins. Defaults to "*" (open) if unset.
# In production set this to your deployed frontend URL.
# CORS_ORIGINS=https://your-frontend.vercel.app

# --- Upload size ---
# Reports carry their photograph inline as a base64 data URI, and an offline queue flush can
# send several at once. Larger bodies are refused with a readable JSON 413.
# MAX_CONTENT_MB=16

# --- Port ---
# Most hosts (Render/Railway) inject PORT automatically.
# PORT=5001

# --- Existing cross-border optimiser (unchanged) ---
# The Google Maps key is read from data/external/google_api_key.txt if present.
# Without it the original optimiser falls back to haversine distances.
