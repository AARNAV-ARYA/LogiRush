# Backend API. Leave unset to use http://localhost:5001
#
# The mobile field app must point at this SAME url (nerFieldApp/.env →
# EXPO_PUBLIC_API_BASE_URL). Both are clients of one backend and one incidents table, so
# matching these two values is the whole of what makes a report filed on a phone appear in
# the review queue here. Different values is what makes the two look unconnected.
VITE_API_BASE_URL=http://localhost:5001

# Basemap tiles.
# Default is keyless Esri World Imagery (real satellite/aerial photography) with a keyless
# Esri place-names/borders overlay on top — no account, no watermark, no key to leak here.
# To use a different provider in production, set the URL(s) and mark the theme so the CSS
# tonal treatment matches what's being served:
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key=YOUR_KEY
#   VITE_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
#   VITE_MAP_TILE_THEME=dark   # "light" | "dark" | "satellite" (default)
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=
# VITE_MAP_TILE_SUBDOMAINS=
# VITE_MAP_TILE_THEME=satellite

# Label/border overlay drawn on top of the imagery. Only relevant when the tile theme is
# "satellite" — light/dark vector basemaps already carry their own labels.
# VITE_MAP_LABELS_URL=
# VITE_MAP_LABELS_SUBDOMAINS=
